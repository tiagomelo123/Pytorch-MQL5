# Copie este arquivo para .streamlit/secrets.toml e preencha com seus dados.
# NUNCA versione o secrets.toml real (já está no .gitignore).

[firebase]
# Caminho local para o arquivo JSON da service account do Firebase
# (Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
credentials_path = "C:/caminho/para/service_account.json"

# Nome do bucket do Firebase Storage (geralmente "<projeto>.appspot.com")
storage_bucket = "seu-projeto.appspot.com"
